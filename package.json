{
  "name": "forma-editor",
  "version": "0.4.2",
  "private": true,
  "description": "A calmer space for your next cut. Cross-platform AI video editor foundations.",
  "author": "Gonzolt",
  "license": "UNLICENSED",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "postinstall": "install-electron && node tools/prepare-ffmpeg.cjs",
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:desktop": "node tools/smoke-desktop.mjs",
    "test:motionkit": "node tools/smoke-motionkit.mjs",
    "test:updates": "node tools/smoke-updates.mjs",
    "format": "prettier --write src electron tests tools/*.mjs *.json *.ts .github/workflows/*.yml README.md",
    "pack": "npm run build && electron-builder --dir --publish never",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg zip --publish never"
  },
  "dependencies": {
    "@fontsource/instrument-serif": "^5.2.5",
    "@fontsource/inter-tight": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^10.0.6",
    "electron": "45.1.0",
    "electron-builder": "26.15.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.0",
    "vite": "8.3.5",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.gonzolt.forma",
    "productName": "Forma",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "extraResources": [
      {
        "from": "vendor/motionkit",
        "to": "motionkit",
        "filter": [
          "**/*",
          ".claude/**/*"
        ]
      },
      {
        "from": "vendor/UPSTREAM.md",
        "to": "MOTIONKIT-UPSTREAM.md"
      }
    ],
    "beforePack": "./tools/before-pack.cjs",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.video"
    },
    "artifactName": "Forma-${version}-${os}-${arch}.${ext}"
  }
}
